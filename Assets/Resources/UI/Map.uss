/* Ban do nho + ban do lon (ban web: #mini, #bigmap). */
#minimap { position: absolute; top: 66px; right: 12px; width: 168px; height: 168px; padding: 0; overflow: hidden; border-radius: 16px; }
.mini-img { position: absolute; left: 3px; top: 3px; right: 3px; bottom: 3px; border-radius: 10px; }
.mini-hint { position: absolute; right: 6px; bottom: 4px; font-size: 11px; -unity-font-style: bold; color: #fff6dc;
             -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(40, 20, 10, .8); }
.map-marks { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.map-arrow { position: absolute; translate: -50% -50%; font-size: 15px; color: #ffffff; -unity-font-style: bold;
             -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgba(30, 20, 10, .9); }
.map-arrow.big { font-size: 22px; }
.mini-town { position: absolute; width: 7px; height: 7px; translate: -50% -50%; background-color: #c45a3a; border-width: 1px; border-color: #fff3d6; }
.mini-pin { position: absolute; width: 8px; height: 8px; border-radius: 4px; translate: -50% -50%; border-width: 1px; border-color: #ffffff; }

.bigmap-card { width: auto; max-width: 96%; padding: 14px 18px 12px 18px; }
.bm-head { flex-direction: row; align-items: center; justify-content: space-between; }
.bm-info { font-size: 13px; color: var(--ink-2); margin-left: 16px; }
.bm-row { flex-direction: row; margin-top: 6px; }
#bm-map { flex-shrink: 0; border-radius: 12px; overflow: hidden; border-width: 3px; border-color: var(--bark); background-color: #1d6f86; }
.bm-side { width: 300px; flex-shrink: 0; margin-left: 14px; }
.bm-h { font-size: 12px; -unity-font-style: bold; color: var(--ochre-d); letter-spacing: 1px; margin-top: 10px; }
.bm-big { font-size: 24px; -unity-font-style: bold; }
.bm-p { font-size: 14px; white-space: normal; margin-top: 2px; }
.bm-hl { color: #b9661c; -unity-font-style: bold; }
.bm-dim { color: var(--ink-2); font-size: 12px; }
.bm-region { position: absolute; translate: -50% -50%; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center;
             -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgba(30, 20, 10, .85); }
.bm-town { position: absolute; width: 10px; height: 10px; translate: -50% -50%; background-color: #c45a3a; border-width: 2px; border-color: #fff3d6; }
.bm-town-label { position: absolute; translate: -50% 0; font-size: 12px; -unity-font-style: bold; color: #fff3d6;
                 -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgba(30, 20, 10, .85); }
.bm-pin { position: absolute; width: 18px; height: 18px; border-radius: 9px; translate: -50% -100%; font-size: 11px; -unity-font-style: bold;
          color: #ffffff; -unity-text-align: middle-center; border-width: 2px; border-color: #ffffff; }
.bm-x { position: absolute; translate: -50% -50%; font-size: 30px; -unity-font-style: bold; color: #ff3b2f;
        -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgba(40, 15, 5, .95); }
.bm-x.small { font-size: 16px; }
.mini-bottle { position: absolute; width: 7px; height: 7px; border-radius: 4px; translate: -50% -50%; background-color: #e8fff6; border-width: 1px; border-color: #3f7a6a; }
.bm-legend { flex-direction: row; flex-wrap: wrap; margin-top: 8px; max-width: 1040px; }
.leg-item { flex-direction: row; align-items: center; margin-right: 12px; margin-bottom: 3px; }
.leg-sw { width: 14px; height: 14px; border-radius: 3px; margin-right: 5px; border-width: 1px; border-color: rgba(0, 0, 0, .3); }
.leg-text { font-size: 12px; }
