/* Menu chinh, chon dao, tao nhan vat, cai dat, ghi cong, ung ho, tam dung (ban web: #title, #create, settingsHTML, credits, donate). */
#menu-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
#title-glow { position: absolute; left: 0; top: 0; bottom: 0; width: 62%; }
#motes { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mote { position: absolute; border-radius: 50%; background-color: rgb(255, 236, 160); }

.tcol { position: absolute; left: 7%; top: 12%; bottom: 10%; width: 520px; }
.tbadge { align-self: flex-start; padding: 5px 14px; border-radius: 20px; font-size: 15px; -unity-font-style: bold;
          color: #fff6dc; background-color: rgba(255, 255, 255, .16); border-width: 1px; border-color: rgba(255, 255, 255, .35); }
.tname { font-size: 86px; -unity-font-style: bold; color: #fff8e6; margin-top: 10px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(70, 30, 10, .45); }
.tname-dao { color: #ffc46a; margin-right: 22px; }
.ten { font-size: 18px; color: #ffe8b8; letter-spacing: 9px; margin-top: -8px; }
.ttag { font-size: 18px; color: #fff1d6; white-space: normal; margin-top: 14px; margin-bottom: 18px; max-width: 500px; }

.mb { flex-direction: row; align-items: center; width: 340px; padding: 9px 16px; margin-bottom: 9px; border-radius: 16px;
      background-color: rgba(255, 248, 230, .16); border-width: 1px; border-color: rgba(255, 255, 255, .3);
      transition-property: translate, background-color; transition-duration: .15s; }
.mb:hover { translate: 6px 0; background-color: rgba(255, 248, 230, .28); }
.mb.main { background-color: rgb(236, 120, 76); border-color: rgb(255, 196, 150); }
.mb.main:hover { background-color: rgb(244, 136, 90); }
.mb.don { border-color: rgb(255, 160, 170); }
.mb-icon { font-size: 22px; width: 36px; color: #fff6dc; -unity-text-align: middle-center; align-items: center; justify-content: center; }
.mb-title { font-size: 19px; -unity-font-style: bold; color: #fffaf0; }
.mb-sub { font-size: 13px; color: #ffe8c8; }
.tfoot { position: absolute; left: 7%; right: 7%; bottom: 3%; flex-direction: row; justify-content: space-between; }
.tfoot Label { font-size: 13px; color: rgba(255, 240, 210, .8); }

/* ---------- bang chung ---------- */
.menu-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(26, 18, 10, .5); align-items: center; justify-content: center; }
.menu-card { width: 640px; max-height: 90%; background-color: var(--paper); border-width: 4px; border-bottom-width: 8px; border-color: var(--bark);
             border-radius: 20px; padding: 18px 22px 16px 22px; }
.menu-card.wide { width: 820px; }
.menu-buttons { flex-direction: row; justify-content: flex-end; margin-top: 10px; }
.menu-buttons .btn { margin-left: 10px; }
.btn.danger { background-color: #c4442f; border-color: #7a2418; }
.btn.muted { background-color: #8a7a5a; border-color: #5a4a3a; }

/* o luu */
.isl { flex-direction: row; align-items: center; padding: 8px 12px; margin-bottom: 8px; border-radius: 14px; background-color: var(--paper-2); }
.isl.empty { opacity: .8; }
.isl-badge { width: 46px; height: 46px; border-radius: 23px; background-color: #e8c88a; margin-right: 12px; -unity-text-align: middle-center; font-size: 20px; -unity-font-style: bold; color: #6b4423; }
.isl-text { flex-grow: 1; }
.isl-name { font-size: 17px; -unity-font-style: bold; }
.isl-info { font-size: 13px; color: var(--ink-2); white-space: normal; }
.isl .btn { margin-left: 8px; min-width: 70px; }

/* tao nhan vat */
.create-card { position: absolute; right: 6%; top: 8%; width: 470px; max-height: 86%; }
.create-row { flex-direction: row; align-items: center; margin-top: 6px; }
.create-label { width: 92px; font-size: 14px; -unity-font-style: bold; color: var(--ink-2); }
.swatch { width: 30px; height: 30px; border-radius: 15px; margin-right: 6px; border-width: 3px; border-color: rgba(0, 0, 0, 0); }
.swatch.on { border-color: var(--bark); }
.seg { flex-direction: row; }
.seg .btn { margin-right: 8px; min-width: 90px; }
.seg .btn.off { background-color: #c8b48a; border-color: #8a7a5a; }
.name-field { flex-grow: 1; font-size: 17px; }
.err { color: #c4442f; font-size: 13px; -unity-font-style: bold; margin-top: 4px; }

/* cai dat */
.set-row { flex-direction: row; align-items: center; margin-top: 8px; }
.set-label { width: 240px; font-size: 15px; white-space: normal; flex-shrink: 0; }
.set-row .seg .btn { min-width: 70px; }
.set-row .seg.seg-tight .btn { min-width: 0; margin-right: 5px; padding-left: 12px; padding-right: 12px; }
.set-row Slider { flex-grow: 1; }
.set-value { width: 54px; font-size: 14px; -unity-text-align: middle-right; color: var(--ink-2); }
.set-section { font-size: 13px; -unity-font-style: bold; color: var(--ink-2); margin-top: 12px; letter-spacing: 1px; }

/* ghi cong */
.cr-logo { font-size: 44px; -unity-font-style: bold; -unity-text-align: middle-center; color: var(--ink); }
.cr-logo-sub { font-size: 14px; letter-spacing: 8px; -unity-text-align: middle-center; color: var(--ink-2); margin-bottom: 8px; }
.cr-h { font-size: 16px; -unity-font-style: bold; color: var(--ochre-d); margin-top: 10px; -unity-text-align: middle-center; }
.cr-p { font-size: 14px; white-space: normal; -unity-text-align: middle-center; }
.cr-note { font-size: 13px; white-space: normal; -unity-text-align: middle-center; color: var(--ink-2); margin-top: 12px; -unity-font-style: italic; }

/* ung ho */
#donate-qr { width: 230px; height: 354px; align-self: center; border-radius: 18px; margin: 6px 0 10px 0; }
.don-text { font-size: 15px; white-space: normal; -unity-text-align: middle-center; }

/* tam dung */
.pause-card { width: 360px; align-items: stretch; }
.pause-card .btn { margin-top: 8px; align-self: stretch; }
/* cai dat: 4 tab + bang phim (huong dan) */
.set-tabs { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.set-tabs .btn { margin-right: 6px; margin-bottom: 4px; padding-left: 14px; padding-right: 14px; }
.set-tabs .btn.off { background-color: #c8b48a; border-color: #8a7a5a; }
.help-row { flex-direction: row; align-items: flex-start; margin-top: 6px; }
.help-key { width: 190px; flex-shrink: 0; font-size: 14px; -unity-font-style: bold; color: var(--ink); white-space: normal; }
.help-what { flex-grow: 1; flex-shrink: 1; font-size: 14px; color: var(--ink-2); white-space: normal; }
